{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": null,
  "functions": {
    "api/handler.js": {
      "maxDuration": 30,
      "includeFiles": "node_modules/{impeccable/cli/bin/**,impeccable/skill/scripts/engine-checksums.txt,impeccable/package.json,@impeccable/cli-linux-x64/**}"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/handler" }
  ]
}
