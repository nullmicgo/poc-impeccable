{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "public": false,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "maxLambdaSize": "50mb",
        "includeFiles": "node_modules/{impeccable/cli/bin/**,impeccable/skill/scripts/engine-checksums.txt,impeccable/package.json}"
      }
    }
  ],
  "routes": [
    { "src": "/(?!api/index\\.js$).*", "dest": "/api/index.js" }
  ]
}
